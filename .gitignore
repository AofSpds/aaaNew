# Local Claude Code settings and worktrees (per machine, may hold permissions)
.claude/settings.local.json
.claude/worktrees/

# Third-party agent installs under rsch/ref-apps (reinstallable; data/ folders may hold logins and session state)
# Keep only launcher/install scripts, package manifests and the small Chainlit app files.
projects/bootstrap/rsch/ref-apps/chainlit/*
!projects/bootstrap/rsch/ref-apps/chainlit/*.ps1
!projects/bootstrap/rsch/ref-apps/chainlit/app.py
!projects/bootstrap/rsch/ref-apps/chainlit/chainlit.md
!projects/bootstrap/rsch/ref-apps/chainlit/requirements.txt
projects/bootstrap/rsch/ref-apps/hermes/*
!projects/bootstrap/rsch/ref-apps/hermes/*.ps1
projects/bootstrap/rsch/ref-apps/omp/*
!projects/bootstrap/rsch/ref-apps/omp/*.ps1
!projects/bootstrap/rsch/ref-apps/omp/build-manifest.json
projects/bootstrap/rsch/ref-apps/opencode/*
!projects/bootstrap/rsch/ref-apps/opencode/*.ps1
!projects/bootstrap/rsch/ref-apps/opencode/package.json
!projects/bootstrap/rsch/ref-apps/opencode/package-lock.json
projects/bootstrap/rsch/ref-apps/pi/pi-web/*
!projects/bootstrap/rsch/ref-apps/pi/pi-web/package.json
!projects/bootstrap/rsch/ref-apps/pi/pi-web/package-lock.json

# Large backups (6.47 GB zip and its copies)
projects/bootstrap/rsch/research/sub-memory/backups/

# Python / Node environments and caches anywhere
.venv/
venv/
.cache/
.uv-cache/
node_modules/
__pycache__/
*.pyc

# Relation engine derived files (rebuilt from jsonl, see RELATION_ENGINE_PLAN D1)
projects/bootstrap/memory-store/index.sqlite
projects/bootstrap/memory-store/records/local/

# Logs
*.log
